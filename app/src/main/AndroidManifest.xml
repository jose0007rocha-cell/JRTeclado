<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_edit"
        android:allowBackup="true">
        <activity android:name=".SettingsActivity" android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".SubTelaActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>
        <activity android:name=".TemasActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>
        <activity android:name=".EditorTemaActivity" android:exported="false"
            android:windowSoftInputMode="adjustPan"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>
        <service android:name=".TecladoService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>
    </application>
</manifest>
